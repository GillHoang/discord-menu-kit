{
  "name": "discord-menu-kit",
  "version": "0.1.0",
  "description": "Discord bot framework: one slash command opens a menu, buttons/selects/modals are routed to decorated handlers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch example/main.ts",
    "start": "tsx example/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
